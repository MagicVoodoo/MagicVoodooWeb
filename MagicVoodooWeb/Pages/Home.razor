@page "/"

<div class="mv-hero">

    <HeroLogo />

    <p class="mv-tagline">
        Software Architecture, AI Integration, and Cross-Platform Development.
    </p>

    <section class="mv-content mv-section">
        <h2 class="mv-section-title">About Magic Voodoo</h2>

        <p>
            Magic Voodoo, LLC is a software consultancy focused on architecture,
            modern application development, AI integration, and complex system design.
            We help organizations build scalable software across web, mobile,
            desktop, cloud, and embedded platforms.
        </p>

        <p>
            Founded by Todd Henderson, Magic Voodoo brings more than 25 years
            of experience delivering software solutions across healthcare,
            finance, media, broadcasting, e-commerce, and emerging technologies.
        </p>
    </section>
    
    <section class="mv-content mv-section">
        <h2 class="mv-section-title">What We Do</h2>

        <ul class="mv-services-list">
            <li>Software Architecture & Technical Leadership</li>
            <li>AI Integration & Developer Tooling</li>
            <li>.NET, Blazor, and .NET MAUI Development</li>
            <li>Cross-Platform Mobile & Desktop Applications</li>
            <li>Performance Optimization & System Integrations</li>
            <li>Legacy Application Modernization</li>
        </ul>
    </section>

    <section class="mv-content mv-section">
    <h2 class="mv-section-title">Availability</h2>

    <p>
        Currently accepting remote consulting, architecture review,
        technical leadership, and contract development engagements.
    </p>
    </section>

    <section class="mv-content mv-section">

        <h2 class="mv-section-title">Open Source</h2>

        <p>

            Magic Voodoo also supports open-source work exploring AI-assisted

            software development, deterministic systems, and developer tooling.

        </p>

        <p>

            These projects are part of our broader research and community work,

            while client consulting remains our primary business focus.

        </p>

    </section>

    <section class="mv-section">
        <button class="mv-btn mv-btn-primary" @onclick="ContactButtonClicked">
            Contact Us
        </button>
    </section>

    <ContactForm @bind-Visible="_contactFormVisible" />

</div>


@code {
    bool _contactFormVisible = false;

    private void ContactButtonClicked()
    {
        _contactFormVisible = true;
    }

}
